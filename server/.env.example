# 大模型API配置（小米MiMo）
LLM_API_KEY=your_xiaomi_api_key_here
LLM_BASE_URL=https://api.xiaomi.com/v1
LLM_MODEL=MiMo-V2.5-Flash

# 嵌入模型API配置（阿里云百炼）
EMBED_API_KEY=your_dashscope_api_key_here
EMBED_BASE_URL=https://your-endpoint.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=qwen3.7-text-embedding

# MySQL数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=db_enterprise_qa